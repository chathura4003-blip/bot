{
  "name": "chathu-md-bot",
  "version": "1.5.0",
  "description": "WhatsApp automation bot with an administration dashboard",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node --expose-gc --max-old-space-size=2048 --max-semi-space-size=64 index.js",
    "check": "npm run lint && npm run test",
    "lint": "node scripts/check-syntax.js",
    "test": "node --test",
    "validate-config": "node scripts/validate-config.js",
    "smoke-whatsapp": "node scripts/smoke-whatsapp.js",
    "build": "node scripts/build-check.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "npm:atexovi-baileys@7.5.6",
    "axios": "^1.20.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^0.0.6",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^10.4.3",
    "openai": "^6.49.0",
    "pino": "^9.14.0",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.5",
    "systeminformation": "^5.33.5",
    "translate-google-api": "^1.0.4",
    "yt-dlp-wrap": "^2.3.2"
  }
}
